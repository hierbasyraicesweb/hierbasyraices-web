---
export const prerender = false;

import { supabase } from '../../lib/supabase';
import '../../styles/global.css';

const plantId = Astro.params.id;

const { data: plant, error } = await supabase
  .from('plants')
  .select('*')
  .eq('id', plantId)
  .single();

if (error) {
  console.error('Error al consultar Supabase:', error);
}
---

<html lang="es">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{plant?.nombre_principal || 'Planta no encontrada'} - Hierbas y Raíces</title>
  </head>
  <body class="bg-base-200 min-h-screen" data-theme="hierbas">
    <!-- Header -->
    <div class="navbar bg-base-100 shadow-lg">
      <div class="flex-1">
        <a href="/" class="btn btn-ghost normal-case text-xl">
          <span class="text-2xl">🌿</span>
          <span class="text-primary font-bold">Hierbas</span>
          <span class="text-secondary font-bold">y Raíces</span>
        </a>
      </div>
      
      <!-- BOTÓN IR A LA TIENDA (parte superior derecha) -->
      <div class="flex-none">
        <a href="/tienda" class="btn bg-[#ff9900] text-[#232f3e] font-semibold hover:bg-[#e88a00] border-none">
           Ir a la Tienda →
        </a>
      </div>
    </div>

    <!-- Main Content -->
    <div class="container mx-auto px-4 py-8 max-w-4xl">
      
      {error ? (
        <div class="alert alert-error">
          <span>Error: {error.message}</span>
        </div>
      ) : plant ? (
        <article class="bg-base-100 shadow-xl rounded-lg p-8">
          
          <!-- Botón volver -->
          <a href="/" class="btn btn-ghost btn-sm mb-6 text-secondary">
            ← Volver al listado
          </a>

          <!-- Título principal -->
          <h1 class="text-4xl font-bold text-primary mb-2">
            {plant.nombre_principal}
          </h1>
          
          <!-- Nombre científico -->
          <p class="text-lg italic text-secondary mb-6">
            {plant.nombre_cientifico}
          </p>

          <!-- Info básica -->
          <div class="flex flex-wrap gap-3 mb-8">
            {plant.familia_botanica && (
              <span class="badge badge-lg" style="background-color: #8b6f47; color: white;">
                {plant.familia_botanica}
              </span>
            )}
            {plant.categoria && (
              <span class="badge badge-lg badge-outline" style="border-color: #2d5016; color: #2d5016;">
                {plant.categoria}
              </span>
            )}
          </div>

          <!-- Nombres por región -->
          {plant.nombres_espana && (
            <div class="mb-6">
              <h2 class="text-xl font-bold text-primary mb-2">🇸 Nombres en España</h2>
              <p class="text-base-content">{plant.nombres_espana}</p>
            </div>
          )}

          {plant.nombres_cono_sur && (
            <div class="mb-6">
              <h2 class="text-xl font-bold text-primary mb-2">🌎 Nombres en el Cono Sur</h2>
              <p class="text-base-content">{plant.nombres_cono_sur}</p>
            </div>
          )}

          {plant.nombres_andinos && (
            <div class="mb-6">
              <h2 class="text-xl font-bold text-primary mb-2">🏔️ Nombres Andinos</h2>
              <p class="text-base-content">{plant.nombres_andinos}</p>
            </div>
          )}

          {plant.nombres_mexico_ca && (
            <div class="mb-6">
              <h2 class="text-xl font-bold text-primary mb-2">🌵 Nombres en México y Centroamérica</h2>
              <p class="text-base-content">{plant.nombres_mexico_ca}</p>
            </div>
          )}

          <!-- Origen y Tradición -->
          {plant.origen_tradicion && (
            <div class="mb-6">
              <h2 class="text-xl font-bold text-primary mb-2"> Origen y Tradición</h2>
              <p class="text-base-content leading-relaxed">{plant.origen_tradicion}</p>
            </div>
          )}

          <!-- Usos Tradicionales -->
          {plant.usos_tradicionales && (
            <div class="mb-6">
              <h2 class="text-xl font-bold text-primary mb-2">💚 Usos Tradicionales</h2>
              <p class="text-base-content leading-relaxed">{plant.usos_tradicionales}</p>
            </div>
          )}

          <!-- Preparación Tradicional -->
          {plant.preparacion_tradicional && (
            <div class="mb-6">
              <h2 class="text-xl font-bold text-primary mb-2">🍵 Preparación Tradicional</h2>
              <p class="text-base-content leading-relaxed">{plant.preparacion_tradicional}</p>
            </div>
          )}

          <!-- Partes Utilizadas -->
          {plant.partes_utilizadas && (
            <div class="mb-6">
              <h2 class="text-xl font-bold text-primary mb-2">🌱 Partes Utilizadas</h2>
              <p class="text-base-content leading-relaxed">{plant.partes_utilizadas}</p>
            </div>
          )}

          <!-- Advertencia -->
          {plant.advertencia && (
            <div class="alert alert-warning mb-6" style="background-color: #fff3cd; border-left: 4px solid #8b6f47;">
              <span class="text-2xl">⚠️</span>
              <div>
                <h3 class="font-bold text-lg" style="color: #3d2817;">Advertencia</h3>
                <p class="text-sm" style="color: #3d2817;">{plant.advertencia}</p>
              </div>
            </div>
          )}

          <!-- Fuentes -->
          {plant.fuentes && (
            <div class="mb-6">
              <h2 class="text-xl font-bold text-primary mb-2">📚 Fuentes</h2>
              <p class="text-base-content text-sm">{plant.fuentes}</p>
            </div>
          )}

        </article>
      ) : (
        <div class="alert alert-warning">
          <span>Planta no encontrada</span>
        </div>
      )}

      <!-- Footer -->
      <footer class="footer footer-center p-10 mt-12" style="background-color: #3d2817; color: #f5f5dc;">
        <div>
          <p class="font-bold text-lg">🌿 Hierbas <span style="color: #8b6f47;">y Raíces</span></p>
          <p>Enciclopedia de plantas medicinales tradicionales</p>
          <p class="text-sm mt-2">
            Conocimiento ancestral para el bienestar natural
          </p>
        </div>
      </footer>
    </div>
  </body>
</html>