---
import '../styles/global.css';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import HeroSection from '../components/HeroSection.astro';
import Footer from '../components/Footer.astro';
import videos from '../data/videos.json';
---

<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Videos - Hierbas y Raíces</title>
  <meta name="description" content="Galería de videos sobre historia, usos tradicionales y preparación de plantas medicinales. Tráfico bidireccional con nuestro canal de YouTube." />
  <GoogleAnalytics />
</head>
<body class="bg-[#f5f5dc] flex flex-col min-h-screen">

  <!-- CABECERA UNIFICADA: los botones van AQUÍ, en la parte verde, centrados -->
  <HeroSection 
    title="Hierbas y Raíces" 
    subtitle="Enciclopedia de Plantas Medicinales Tradicionales" 
    showBackButton={true} 
    showShopButton={true} 
    showBlogButton={true} 
  />

  <!-- CONTENIDO PRINCIPAL DE VIDEOS -->
  <main class="flex-grow">
    <section class="py-8 px-4">
      <div class="max-w-6xl mx-auto">
        
        <h2 class="text-3xl font-bold text-[#2d5016] text-center mb-4">Galería de Videos</h2>
        <p class="text-center text-gray-700 mb-8 max-w-2xl mx-auto">
          Haz clic en cualquier miniatura para ver el video completo en nuestro canal de YouTube. 
          <br><span class="text-sm italic text-stone-500">*Todo el contenido tiene fines exclusivamente históricos, educativos y culturales.</span>
        </p>

        <!-- REJILLA DE VIDEOS -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

          {videos.map((video) => (
            <a 
              href={`https://www.youtube.com/watch?v=${video.id_youtube}`} 
              target="_blank" 
              rel="noopener noreferrer"
              class="planta-card bg-white rounded-xl shadow-lg overflow-hidden border-2 border-[#c8e6c9] hover:border-[#81c784] transition-all flex flex-col group"
            >
              <!-- Miniatura oficial de YouTube -->
              <div class="relative aspect-video bg-gray-200">
                <img 
                  src={`https://img.youtube.com/vi/${video.id_youtube}/hqdefault.jpg`} 
                  alt={video.titulo}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
                <!-- Icono de Play superpuesto -->
                <div class="absolute inset-0 flex items-center justify-center bg-black/20 group-hover:bg-black/40 transition-colors">
                  <div class="w-16 h-16 bg-red-600 rounded-full flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white ml-1" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
                    </svg>
                  </div>
                </div>
              </div>
              
              <!-- Info del video -->
              <div class="p-6 flex flex-col flex-grow">
                <h3 class="text-xl font-bold text-[#33691e] mb-2 group-hover:text-[#2d5016] transition-colors">
                  {video.titulo}
                </h3>
                <p class="text-gray-700 text-sm mb-4 flex-grow">{video.descripcion}</p>
                <div class="flex items-center justify-between text-xs text-gray-500">
                  <span>{video.fecha}</span>
                  <span class="flex items-center text-red-600 font-semibold">
                    Ver en YouTube 
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                  </span>
                </div>
              </div>
            </a>
          ))}

        </div>

      </div>
    </section>
  </main>

  <!-- FOOTER UNIFICADO -->
  <Footer />

</body>
</html>